<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nur der Whisper-Hilfsprozess darf das whisper.cpp-Framework laden (es trägt keine Team-ID).
	     Er hat keinen Zugriff auf Mikrofon, Bildschirm oder Bedienungshilfen. Die App selbst lädt es nicht. -->
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
