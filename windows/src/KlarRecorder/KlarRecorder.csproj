<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kleines Hilfsprogramm für die Bildschirmaufnahme. ScreenRecorderLib ist eine C++/CLI-Bibliothek
       für das .NET Framework und lässt sich nicht in die .NET-10-App laden. Deshalb läuft die Aufnahme
       in einem eigenen Prozess; .NET Framework 4.8 ist auf Windows 10 und 11 vorinstalliert. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KlarRecorder</AssemblyName>
    <RootNamespace>KlarRecorder</RootNamespace>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
